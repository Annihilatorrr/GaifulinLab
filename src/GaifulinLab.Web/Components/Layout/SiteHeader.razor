@using GaifulinLab.Web.Authentication
@using GaifulinLab.Web.Features
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IConfiguration Configuration
@inject TokenAuthenticationStateProvider AuthenticationStateProvider

<header class="site-header">
    <div class="site-container header-content">
        <a class="brand" href="/" aria-label="Gaifulin Lab home">
            <span class="brand-mark" aria-hidden="true">
                <span class="brand-g">G</span>
                <span class="brand-l">L</span>
            </span>

            <span class="brand-copy">
                <span class="brand-name">GAIFULIN LAB</span>
                <span class="brand-tagline">Software · DSP · Embedded · Systems · Experiments</span>
            </span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
            <a href="/topics">
                Topics
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
            </a>
            <a href="/series">Series</a>
            <a href="/tags">Tags</a>
            <a href="/archive">Archive</a>
            <a href="/about">About</a>
            @if (ShowRegistrationLink)
            {
                <a href="/register">Register</a>
            }
        </nav>

        <div class="header-actions">
            <a class="search-link" href="/search" aria-label="Search">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" />
                    <path d="m16 16 4.5 4.5" />
                </svg>
            </a>
            <ThemeToggle />

            <details class="mobile-menu">
                <summary aria-label="Open navigation">
                    <span></span><span></span><span></span>
                </summary>
                <nav aria-label="Mobile navigation">
                    <a href="/topics">Topics</a>
                    <a href="/series">Series</a>
                    <a href="/tags">Tags</a>
                    <a href="/archive">Archive</a>
                    <a href="/about">About</a>
                    @if (ShowRegistrationLink)
                    {
                        <a href="/register">Register</a>
                    }
                </nav>
            </details>
        </div>
    </div>
</header>

@code {
    private bool _registrationLinkEnabled;
    private bool _isLoggedIn;

    private bool ShowRegistrationLink =>
        RegistrationLinkVisibility.ShouldShow(_registrationLinkEnabled, _isLoggedIn);

    protected override async Task OnInitializedAsync()
    {
        _registrationLinkEnabled = Configuration.GetValue<bool>("Features:RegistrationLinkEnabled");
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;

        await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isLoggedIn = AuthenticationStateProvider.IsLoggedIn;
    }

    private void HandleAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        _ = InvokeAsync(async () =>
        {
            await authenticationStateTask;
            _isLoggedIn = AuthenticationStateProvider.IsLoggedIn;
            StateHasChanged();
        });
    }

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
}
