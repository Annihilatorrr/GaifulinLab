@using GaifulinLab.Web.Authentication
@using GaifulinLab.Web.Features
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IConfiguration Configuration
@inject TokenAuthenticationStateProvider AuthenticationStateProvider

<header class="site-header">
    <div class="site-container header-content">
        <a class="brand" href="/" aria-label="@L["nav.homeAria"]">
            <span class="brand-mark" aria-hidden="true">
                <span class="brand-g">G</span>
                <span class="brand-l">L</span>
            </span>

            <span class="brand-copy">
                <span class="brand-name">GAIFULIN LAB</span>
                <span class="brand-tagline">@L["nav.tagline"]</span>
            </span>
        </a>

        <nav class="desktop-nav" aria-label="@L["nav.primary"]">
            <a href="/topics">@L["nav.topics"]</a>
            <a href="/series">@L["nav.series"]</a>
            <a href="/tags">@L["nav.tags"]</a>
            <a href="/archive">@L["nav.archive"]</a>
            <a href="/about">@L["nav.about"]</a>
            @if (_isLoggedIn)
            {
                <a href="/admin/articles">@L["nav.myArticles"]</a>
            }
            else
            {
                @if (ShowSignInLink)
                {
                    <a href="/admin/login">@L["nav.signIn"]</a>
                }
                @if (ShowRegistrationLink)
                {
                    <a href="/register">@L["nav.register"]</a>
                }
            }
        </nav>

        <div class="header-actions">
            <a class="search-link" href="/search" aria-label="@L["nav.search"]">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" />
                    <path d="m16 16 4.5 4.5" />
                </svg>
            </a>
            <LanguageSwitcher />
            <ThemeToggle />

            <details class="mobile-menu">
                <summary aria-label="@L["nav.open"]">
                    <span></span><span></span><span></span>
                </summary>
                <nav aria-label="@L["nav.mobile"]">
                    <a href="/topics">@L["nav.topics"]</a>
                    <a href="/series">@L["nav.series"]</a>
                    <a href="/tags">@L["nav.tags"]</a>
                    <a href="/archive">@L["nav.archive"]</a>
                    <a href="/about">@L["nav.about"]</a>
                    @if (_isLoggedIn)
                    {
                        <a href="/admin/articles">@L["nav.myArticles"]</a>
                    }
                    else
                    {
                        @if (ShowSignInLink)
                        {
                            <a href="/admin/login">@L["nav.signIn"]</a>
                        }
                        @if (ShowRegistrationLink)
                        {
                            <a href="/register">@L["nav.register"]</a>
                        }
                    }
                </nav>
            </details>
        </div>
    </div>
</header>

@code {
    private bool _signInLinkEnabled;
    private bool _registrationLinkEnabled;
    private bool _isLoggedIn;

    private bool ShowSignInLink =>
        SignInLinkVisibility.ShouldShow(_signInLinkEnabled, _isLoggedIn);

    private bool ShowRegistrationLink =>
        RegistrationLinkVisibility.ShouldShow(_registrationLinkEnabled, _isLoggedIn);

    protected override async Task OnInitializedAsync()
    {
        _signInLinkEnabled = Configuration.GetValue<bool>("Features:SignInLinkEnabled");
        _registrationLinkEnabled = Configuration.GetValue<bool>("Features:RegistrationLinkEnabled");
        AuthenticationStateProvider.AuthenticationStateChanged += HandleAuthenticationStateChanged;

        await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isLoggedIn = AuthenticationStateProvider.IsLoggedIn;
    }

    private void HandleAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        _ = InvokeAsync(async () =>
        {
            await authenticationStateTask;
            _isLoggedIn = AuthenticationStateProvider.IsLoggedIn;
            StateHasChanged();
        });
    }

    public void Dispose() =>
        AuthenticationStateProvider.AuthenticationStateChanged -= HandleAuthenticationStateChanged;
}
