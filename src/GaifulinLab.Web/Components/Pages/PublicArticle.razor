@page "/{LanguageCode}/articles/{Slug}"

<PageTitle>Article · Gaifulin Lab</PageTitle>

<PublicArticleView LanguageCode="@LanguageCode" Slug="@Slug"
                   @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />

@code {
    [Parameter] public string LanguageCode { get; set; } = "en";
    [Parameter] public string Slug { get; set; } = "";
}
