@page "/{LanguageCode}/articles/{Slug}"

<PageTitle>Article · Gaifulin Lab</PageTitle>

<PublicArticleView LanguageCode="@LanguageCode"
                   Slug="@Slug"
                   RequestedLineHeight="@LineHeight"
                   RequestedBlockSpacing="@BlockSpacing"
                   IsPdfRender="@IsPdfRender" />

@code {
    [Parameter] public string LanguageCode { get; set; } = "en";
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "lineHeight")]
    public decimal? LineHeight { get; set; }
    [SupplyParameterFromQuery(Name = "blockSpacing")]
    public decimal? BlockSpacing { get; set; }
    [SupplyParameterFromQuery(Name = "pdf")]
    public string? PdfMode { get; set; }
    private bool IsPdfRender => string.Equals(PdfMode, "1", StringComparison.Ordinal);
}
