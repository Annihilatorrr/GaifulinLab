@page "/about"

<PageTitle>@L["about.title"] · Gaifulin Lab</PageTitle>

<main id="main-content" class="site-main about-page">
    <div class="site-container about-layout">
        <span class="eyebrow">@L["about.eyebrow"]</span>
        <h1>Gaifulin Lab</h1>
        <p class="about-lead">
            @L["about.description"]
        </p>

        <section class="about-note surface" aria-labelledby="about-note-title">
            <h2 id="about-note-title">@L["about.noteTitle"]</h2>
            <p>@L["about.noteDescription"]</p>
        </section>
    </div>
</main>
