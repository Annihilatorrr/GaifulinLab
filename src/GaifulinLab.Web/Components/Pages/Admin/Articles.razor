@page "/admin/articles"
@layout AdminLayout

<PageTitle>@L["admin.articles.pageTitle"] · Gaifulin Lab</PageTitle>

<AdminArticleList Page="@Page" PageSize="@PageSize" />

@code {
    [SupplyParameterFromQuery(Name = "page")] public string? Page { get; set; }
    [SupplyParameterFromQuery(Name = "pageSize")] public string? PageSize { get; set; }
}
