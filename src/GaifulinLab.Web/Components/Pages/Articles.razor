@page "/articles"

<PageTitle>@L["catalog.articles.title"] · Gaifulin Lab</PageTitle>

<PublicContentIndex Kind="articles" LanguageCode="@L.CurrentCode" Eyebrow="@L["catalog.articles.eyebrow"]" Title="@L["catalog.articles.title"]"
                    Description="@L["catalog.articles.description"]"
                    EmptyTitle="@L["catalog.articles.emptyTitle"]" EmptyDescription="@L["catalog.articles.emptyDescription"]"
                    Topic="@Topic" SeriesFilter="@SeriesFilter" Tag="@Tag" />

@code {
    [SupplyParameterFromQuery(Name = "topic")] public string? Topic { get; set; }
    [SupplyParameterFromQuery(Name = "series")] public string? SeriesFilter { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string? Tag { get; set; }
}
