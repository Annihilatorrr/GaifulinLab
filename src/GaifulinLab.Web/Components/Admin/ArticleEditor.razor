    private async Task SaveCoreAsync(bool navigateAfterCreate, bool isAutomaticSave = false)
    {
        // Serialize saves, but allow pending text edits to autosave while a cover upload is in progress.
        if (_saving)
        {
            return;
        }

        // Validate the whole batch before its first request so another localization cannot be saved partially.
        if (HasUntitledDraftToSave)
        {
            return;
        }

        // An edit that is reverted still marks the editor dirty. Do not turn that stale UI state
        // into a save operation: there is nothing to persist or reload for an existing article.
        if (ArticleId is not null
            && !_taxonomyDirty
            && !_localizations.Values.Any(localization => localization.HasChanges))
        {
            CancelAutosaveDelay();
            _autosavePending = false;
            _isDirty = false;
            _saveFailed = false;
            _exportRequiresManualSave = false;
            return;
        }

        (LocalizationModel Model, PublicationStatusDto Status, UpdateArticleLocalizationRequest Request)[]
            localizationUpdates = ArticleId is null
                ? []
                : _localizations.Values
                    .Where(localization => localization.HasChanges)
                    .Select(localization => (
                        Model: localization,
                        localization.Status,
                        Request: localization.ToUpdateRequest()))
                    .ToArray();
        if (localizationUpdates.Any(update =>
                update.Status == PublicationStatusDto.Draft
                && string.IsNullOrWhiteSpace(update.Request.Title)))
        {
            return;
        }

        var saveVersion = _changeVersion;
        if (!isAutomaticSave)
        {
            CancelAutosaveDelay();
        }

        _autosavePending = false;
        _saving = true;
        ClearMessage();
        _hasError = false;
        _saveFailed = false;
        // The timer starts autosave outside a Blazor event, so its busy and settled states need explicit renders.
        if (isAutomaticSave)
        {
            StateHasChanged();
        }
        try
        {
            var wasNew = ArticleId is null;
            if (ArticleId is null)
            {
                var createRequest = Current.ToCreateRequest();
                var created = await ArticlesClient.CreateArticleAsync(createRequest);
                ArticleId = created.ArticleId;
                Current.MarkSaved(createRequest, created.LocalizationVersion);
            }
            // Send the validated snapshots; later edits stay dirty and are handled by the queued autosave.
            foreach (var update in localizationUpdates)
            {
                try
                {
                    var version = await ArticlesClient.UpdateLocalizationAsync(
                        ArticleId.Value,
                        update.Model.LanguageCode,
                        update.Request);
                    update.Model.MarkSaved(update.Request, version);
                }
                catch (AdminApiException exception) when (exception.Code == "article_edit_conflict")
                {
                    await LoadConflictAsync(update.Model);
                    throw;
                }
            }
            if (_taxonomyDirty)
            {
                await ArticlesClient.UpdateTaxonomyAsync(ArticleId.Value, new(
                    _topicIds.ToArray(),
                    _series.Select(item => new SeriesAssignmentRequest(item.Key, item.Value)).ToArray(),
                    ParseTags()));
            }
            if (_changeVersion == saveVersion)
            {
                _taxonomyDirty = false;
                await ReloadLocalizationsAsync(saveVersion);
            }
            RecalculateDirty();
            if (wasNew && navigateAfterCreate) Navigation.NavigateTo($"/admin/articles/{ArticleId}", replace: true);
        }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException)
        {
            _saveFailed = true;
            _autosavePending = false;
            if (_message is null)
            {
                ShowMessage(exception.Message, true);
            }
        }
        finally
        {
            _saving = false;
            if (!isAutomaticSave && !_saveFailed)
            {
                _exportRequiresManualSave = false;
            }
            if (!_saveFailed && _autosavePending && _isDirty && ArticleId is not null)
            {
                QueueAutosave();
            }
            if (isAutomaticSave)
            {
                StateHasChanged();
            }
        }
    }

    private async Task PublishAsync()
    {
        // A queued click must not publish while another save still owns the editor.
        if (IsBusy)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(Current.Title))
        {
            ShowMessage("Add a title before publishing.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(Current.Slug))
        {
            ShowMessage("Add a URL slug before publishing.", true);
            return;
        }

        if (HasUntitledDraftToSave)
        {
            ShowMessage("Add a title to every changed draft before saving.", true);
            return;
        }

        var wasNew = ArticleId is null;
        await SaveCoreAsync(navigateAfterCreate: false);
        if (_hasError || ArticleId is null) return;
        _saving = true;
        try
        {
            await ArticlesClient.PublishAsync(ArticleId.Value, Current.LanguageCode);
            Current.Status = PublicationStatusDto.Published;
            ShowMessage("Localization published.", false);
            if (wasNew) Navigation.NavigateTo($"/admin/articles/{ArticleId}", replace: true);
        }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException) { ShowMessage(exception.Message, true); }
        finally { _saving = false; }
    }

    private async Task UnpublishAsync()
    {
        if (ArticleId is null) return;
        _saving = true;
        try { await ArticlesClient.UnpublishAsync(ArticleId.Value, Current.LanguageCode); Current.Status = PublicationStatusDto.Unpublished; ShowMessage("Localization unpublished.", false); }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException) { ShowMessage(exception.Message, true); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync()
    {
        if (ArticleId is null
            || !await JS.InvokeAsync<bool>("confirm", "Delete this article? It will be hidden from everyone, but kept in storage."))
        {
            return;
        }

        _saving = true;
        ClearMessage();
        try
        {
            await ArticlesClient.DeleteAsync(ArticleId.Value);
            Navigation.NavigateTo("/admin/articles");
        }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException)
        {
            ShowMessage(exception.Message, true);
        }
        finally
        {
            _saving = false;
        }
    }

