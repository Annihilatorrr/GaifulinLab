    }

    private void ToggleSeries(Guid id, ChangeEventArgs args)
    {
        var changed = args.Value is true ? _series.TryAdd(id, 1) : _series.Remove(id);
        if (changed) MarkDirty(taxonomy: true);
    }

    private void SetSeriesPosition(Guid id, ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value)
            && value > 0
            && (!_series.TryGetValue(id, out var existing) || existing != value))
        {
            _series[id] = value;
            MarkDirty(taxonomy: true);
        }
    }

    private void RemoveTopic(Guid id) { if (_topicIds.Remove(id)) MarkDirty(taxonomy: true); }
    private void RemoveSeries(Guid id) { if (_series.Remove(id)) MarkDirty(taxonomy: true); }
    private void RemoveTag(string tag)
    {
        var tags = ParseTags().Where(item => !string.Equals(item, tag, StringComparison.OrdinalIgnoreCase)).ToArray();
        if (tags.Length == ParseTags().Length) return;
        _tags = string.Join(", ", tags);
        MarkDirty(taxonomy: true);
    }
    private string TaxonomyName(IEnumerable<(string LanguageCode, string Name)> names) => names.FirstOrDefault(x => x.LanguageCode == _activeLanguage).Name ?? names.FirstOrDefault().Name ?? "Untitled";
    private static string LanguageName(string languageCode) => languageCode == "ru" ? "Russian" : "English";
    private string LanguageOptionLabel(string languageCode)
    {
        var label = $"{LanguageName(languageCode)} ({languageCode.ToUpperInvariant()})";
        if (ArticleId is null || _localizations.ContainsKey(languageCode))
        {
            return label;
        }

        return $"{label} — add translation";
    }
    private string PublicPath => $"/{Current.LanguageCode}/articles/{(string.IsNullOrWhiteSpace(Current.Slug) ? "{slug}" : Current.Slug.Trim())}";
    private bool CanOpenPublicArticle => Current.Status == PublicationStatusDto.Published && !string.IsNullOrWhiteSpace(Current.Slug);
    private string[] ParseTags() => _tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();

    private void MarkDirty(bool taxonomy = false)
    {
        _taxonomyDirty |= taxonomy;
        _isDirty = true;
        _changeVersion++;
        _saveFailed = false;
        if (_message is not null)
        {
            ClearMessage();
        }
        _hasError = false;
        QueueAutosave();
    }

    private void RecalculateDirty() =>
        _isDirty = _taxonomyDirty || _localizations.Values.Any(localization => localization.HasChanges);

    private void QueueAutosave()
    {
        if (ArticleId is null)
        {
            return;
        }

        _autosavePending = true;
        if (_saving)
        {
            return;
        }

        CancelAutosaveDelay();
        var cancellation = new CancellationTokenSource();
        _autosaveCancellation = cancellation;
        _ = AutosaveAfterDelayAsync(cancellation);
    }

    private async Task AutosaveAfterDelayAsync(CancellationTokenSource cancellation)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(1.2), cancellation.Token);
            if (cancellation.IsCancellationRequested)
            {
                return;
            }

            await InvokeAsync(async () =>
            {
                if (cancellation.IsCancellationRequested || _saving || !_isDirty || ArticleId is null)
                {
                    return;
                }

                _autosavePending = false;
                await SaveCoreAsync(navigateAfterCreate: false, isAutomaticSave: true);
            });
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (_autosaveCancellation == cancellation)
            {
                _autosaveCancellation.Dispose();
                _autosaveCancellation = null;
            }
        }
    }

    private void CancelAutosaveDelay()
    {
        _autosaveCancellation?.Cancel();
        _autosaveCancellation?.Dispose();
        _autosaveCancellation = null;
    }
    private void ShowMessage(string message, bool error)
    {
        ClearMessage();
        _message = message;
        _hasError = error;
        if (!error)
        {
            _messageCancellation = new CancellationTokenSource();
            _ = HideMessageAsync(message, _messageCancellation.Token);
        }
    }

    private async Task HideMessageAsync(string message, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(2.5), cancellationToken);
            await InvokeAsync(() =>
            {
                if (_messageCancellation?.Token == cancellationToken
                    && string.Equals(_message, message, StringComparison.Ordinal))
                {
                    _message = null;
                    _messageCancellation.Dispose();
                    _messageCancellation = null;
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void ClearMessage()
    {
        _messageCancellation?.Cancel();
        _messageCancellation?.Dispose();
        _messageCancellation = null;
        _message = null;
    }

    public void Dispose()
    {
        _previewCancellation?.Cancel();
        _previewCancellation?.Dispose();
        _messageCancellation?.Cancel();
        _messageCancellation?.Dispose();
        CancelAutosaveDelay();
        _splitterReference?.Dispose();
    }

    private sealed class LocalizationModel
    {
        private string _savedTitle = "";
        private string _savedSummary = "";
        private string _savedMarkdown = "";
        private string _savedSlug = "";
        private Guid? _savedCover;

        public LocalizationModel(string languageCode)
        {
            LanguageCode = languageCode;
            SlugIsAutomatic = true;
            CaptureSavedValues();
        }

        public LocalizationModel(string languageCode, LocalizationModel source)
        {
            LanguageCode = languageCode;
            Title = source.Title;
            Summary = source.Summary;
            CoverMediaAssetId = source.CoverMediaAssetId;
            Markdown = source.Markdown;
            Slug = SlugSuggestion.FromTitle(Title);
            SlugIsAutomatic = true;
            CaptureSavedValues();
        }

        public LocalizationModel(AdminArticleLocalizationDto dto)
        {
            Version = dto.Version;
            LanguageCode = dto.LanguageCode;
            Title = dto.Title;
            Summary = dto.Summary ?? "";
            CoverMediaAssetId = dto.CoverMediaAssetId;
            Markdown = dto.Markdown;
            Slug = dto.Slug ?? "";
            Status = dto.Status;
            SlugIsAutomatic = Status == PublicationStatusDto.Draft
                && (string.IsNullOrWhiteSpace(Slug)
                    || string.Equals(
                        Slug,
                        SlugSuggestion.FromTitle(Title),
                        StringComparison.Ordinal));
            CaptureSavedValues();
        }
        public long? Version { get; private set; }
        public string LanguageCode { get; }
        public string Title { get; set; } = "";
        public string Summary { get; set; } = "";
        public Guid? CoverMediaAssetId { get; set; }
        public string Markdown { get; set; } = "";
        public string Slug { get; set; } = "";
        public bool SlugIsAutomatic { get; set; }
        public PublicationStatusDto Status { get; set; } = PublicationStatusDto.Draft;
        public bool HasChanges =>
            !string.Equals(Title, _savedTitle, StringComparison.Ordinal)
            || !string.Equals(Summary, _savedSummary, StringComparison.Ordinal)
            || !string.Equals(Markdown, _savedMarkdown, StringComparison.Ordinal)
            || !string.Equals(Slug, _savedSlug, StringComparison.Ordinal)
            || CoverMediaAssetId != _savedCover;
        public CreateArticleRequest ToCreateRequest() => new(LanguageCode, Title, Summary, Markdown, Slug, CoverMediaAssetId);
        public UpdateArticleLocalizationRequest ToUpdateRequest() => new(Title, Summary, Markdown, Slug, Version, CoverMediaAssetId);
        public void MarkSaved(CreateArticleRequest request, long version) =>
            MarkSaved(new UpdateArticleLocalizationRequest(
                request.Title,
                request.Summary,
                request.Markdown,
                request.Slug, CoverMediaAssetId: request.CoverMediaAssetId), version);
        public void MarkSaved(UpdateArticleLocalizationRequest request, long version)
        {
            Version = version;
            _savedTitle = request.Title ?? "";
            _savedSummary = request.Summary ?? "";
            _savedMarkdown = request.Markdown ?? "";
            _savedSlug = request.Slug ?? "";
            _savedCover = request.CoverMediaAssetId;
        }
        public void UseVersion(long version) => Version = version;
        private void CaptureSavedValues()
        {
            _savedTitle = Title;
            _savedSummary = Summary;
            _savedMarkdown = Markdown;
            _savedSlug = Slug;
            _savedCover = CoverMediaAssetId;
        }
    }
