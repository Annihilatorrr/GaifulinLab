@implements IDisposable
@inject AdminArticlesClient ArticlesClient
@inject AdminMarkdownClient MarkdownClient
@inject AdminMediaClient MediaClient
@inject PublicContentClient ContentClient
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Globalization

<div class="article-editor"
     data-active-pane="@_activePane"
     style="@TypographyStyle">
    <header class="editor-toolbar">
        <a class="back-link" href="/admin/articles" aria-label="Back to articles">←</a>
        <label class="language-picker">
            <span class="visually-hidden">Article language</span>
            <select value="@_activeLanguage" @onchange="HandleLanguageChanged" disabled="@IsBusy"
                    aria-label="Article language">
                @foreach (var language in SupportedLanguages)
                {
                    <option value="@language">@LanguageOptionLabel(language)</option>
                }
            </select>
        </label>
        <div class="article-identity">
            <label class="title-field">
                <span class="visually-hidden">Article title</span>
                <input type="text" placeholder="Untitled article" autocomplete="off"
                       value="@Current.Title" @oninput="HandleTitleInput" disabled="@_loading" />
            </label>
        </div>
        <span class="publication-status @StatusClass">@Current.Status</span>
        <div class="editor-actions" aria-label="Article actions">
            <div class="save-action">
                <button class="button button-primary" type="button" disabled="@(!CanSave)" @onclick="SaveAsync">@SaveButtonLabel</button>
                @if (_saving || _isDirty || _saveFailed)
                {
                    <span class="save-status @SaveStatusClass" role="status">@SaveStatusText</span>
                }
                @if (_message is not null)
                {
                    <span class="toolbar-message @(_hasError ? "message-error" : null)"
                          role="@(_hasError ? "alert" : "status")">@_message</span>
                }
            </div>
            @if (CanPublishCurrent)
            {
                <button class="button button-secondary" type="button" disabled="@IsBusy" @onclick="PublishAsync">Publish</button>
            }
            <details class="action-menu" data-dismiss-on-outside-click>
                <summary class="action-menu-trigger button button-secondary" aria-label="More article actions">⋯</summary>
                <div class="action-menu-content">
                    @if (CanOpenPublicArticle)
                    {
                        <a href="@PublicPath" target="_blank" rel="noopener">Open article</a>
                    }
                    else
                    {
                        <span aria-disabled="true">Open article</span>
                    }
                    <button type="button" disabled="@(IsBusy || Current.Status != PublicationStatusDto.Published)" @onclick="UnpublishAsync">Unpublish</button>
                    <button class="danger-action" type="button" disabled="@(IsBusy || ArticleId is null)" @onclick="DeleteAsync">Delete article</button>
                </div>
            </details>
        </div>
    </header>

    @if (_conflictLanguage is not null && _conflictServer is not null)
    {
        <section class="editor-conflict" role="alert" aria-labelledby="edit-conflict-title">
            <div>
                <h2 id="edit-conflict-title">This localization was changed elsewhere</h2>
                <p>Your draft is still in the editor and has not overwritten the saved version.</p>
            </div>
            <details>
                <summary>Compare with the saved version</summary>
                <label>Saved title <input readonly value="@_conflictServer.Title" /></label>
                <label>Saved summary <textarea readonly>@_conflictServer.Summary</textarea></label>
                <label>Saved Markdown <textarea readonly>@_conflictServer.Markdown</textarea></label>
            </details>
            <div class="editor-conflict-actions">
                <button class="button button-secondary" type="button" @onclick="UseServerConflictAsync">Use saved version</button>
                <button class="button button-primary" type="button" @onclick="SaveMyConflictDraftAsync">Save my draft</button>
            </div>
        </section>
    }

    @if (_loading)
    {
        <div class="editor-message surface" role="status">Loading article…</div>
    }
    else
    {
        <section class="article-settings" aria-label="Article metadata">
            <label class="metadata-field metadata-slug">
                <span class="metadata-label">Slug</span>
                <span class="slug-field">
                    <span aria-hidden="true">/@Current.LanguageCode/articles/</span>
                    <input type="text" placeholder="article-slug" autocomplete="off" spellcheck="false"
                           value="@Current.Slug" @oninput="HandleSlugInput" disabled="@_loading" />
                </span>
            </label>
            <label class="metadata-field metadata-tags">
                <span class="metadata-label">Tags</span>
                <input class="text-field" type="text" placeholder="Separate tags with commas" autocomplete="off"
                       value="@_tags" @oninput="HandleTagsInput" />
            </label>
            <label class="metadata-field metadata-summary">
                <span class="metadata-label">Summary</span>
                <textarea class="summary-field" rows="1" placeholder="Add summary…"
                          value="@Current.Summary" @oninput="HandleSummaryInput"></textarea>
            </label>
            <div class="metadata-controls">
                <div class="metadata-assignment cover-setting">
                    <span class="metadata-label">Cover</span>
                    <details class="metadata-popover" data-dismiss-on-outside-click>
                        <summary>@(Current.CoverMediaAssetId is null ? "+ Add cover" : "Change cover")</summary>
                        <div class="metadata-popover-content">
                            @if (Current.CoverMediaAssetId is { } coverId)
                            {
                                <img class="editor-cover-preview" src="@(ContentClient.AssetBaseUrl.TrimEnd('/') + $"/media/{coverId}")" alt="Article cover" />
                                <button type="button" class="button button-secondary" disabled="@IsBusy" @onclick="RemoveCover">Remove cover</button>
                            }
                            <label>Upload cover<InputFile OnChange="HandleCoverSelected" accept="image/png,image/jpeg,image/webp,image/gif" disabled="@IsBusy" /></label>
                            @if (_coverUploading) { <span role="status">Uploading cover…</span> }
                            @if (_coverError is not null) { <span role="alert">@_coverError</span> }
                        </div>
                    </details>
                </div>
                <div class="metadata-assignment">
                    <span class="metadata-label">Topic</span>
                    <details class="metadata-popover" data-dismiss-on-outside-click>
                        <summary>@(_topicIds.Count == 0 ? "+ Add topic" : $"Topics ({_topicIds.Count})")</summary>
                        <div class="metadata-popover-content">
                            @if (_taxonomy.Topics.Count == 0)
                            {
                                <span class="taxonomy-empty">No topics created yet.</span>
                            }
                            else
                            {
                                <div class="choice-list">
                                    @foreach (var topic in _taxonomy.Topics)
                                    {
                                        <label><input type="checkbox" checked="@_topicIds.Contains(topic.Id)" @onchange="eventArgs => ToggleTopic(topic.Id, eventArgs)" /> @TaxonomyName(topic.Localizations.Select(x => (x.LanguageCode, x.Name)))</label>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                </div>

                <div class="metadata-assignment">
                    <span class="metadata-label">Series</span>
                    <details class="metadata-popover" data-dismiss-on-outside-click>
                        <summary>@(_series.Count == 0 ? "+ Add series" : $"Series ({_series.Count})")</summary>
                        <div class="metadata-popover-content">
                            @if (_taxonomy.Series.Count == 0)
                            {
                                <span class="taxonomy-empty">No series created yet.</span>
                            }
                            else
                            {
                                <div class="choice-list">
                                    @foreach (var series in _taxonomy.Series)
                                    {
                                        <label>
                                            <input type="checkbox" checked="@_series.ContainsKey(series.Id)" @onchange="eventArgs => ToggleSeries(series.Id, eventArgs)" />
                                            @TaxonomyName(series.Localizations.Select(x => (x.LanguageCode, x.Title)))
                                            @if (_series.TryGetValue(series.Id, out var position))
                                            {
                                                <input class="position-field" type="number" min="1" value="@position" @onchange="eventArgs => SetSeriesPosition(series.Id, eventArgs)" aria-label="Position in series" />
                                            }
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    </details>
                </div>
            </div>

            @if (ParseTags().Length > 0 || _topicIds.Count > 0 || _series.Count > 0)
            {
                <div class="metadata-chip-row" aria-label="Selected article metadata">
                    @foreach (var tag in ParseTags())
                    {
                        <button class="metadata-chip" type="button" @onclick="() => RemoveTag(tag)" aria-label="Remove tag @tag">@tag <span aria-hidden="true">&times;</span></button>
                    }
                    @foreach (var topic in _taxonomy.Topics.Where(item => _topicIds.Contains(item.Id)))
                    {
                        var name = TaxonomyName(topic.Localizations.Select(x => (x.LanguageCode, x.Name)));
                        <button class="metadata-chip" type="button" @onclick="() => RemoveTopic(topic.Id)" aria-label="Remove topic @name">@name <span aria-hidden="true">&times;</span></button>
                    }
                    @foreach (var series in _taxonomy.Series.Where(item => _series.ContainsKey(item.Id)))
                    {
                        var title = TaxonomyName(series.Localizations.Select(x => (x.LanguageCode, x.Title)));
                        <button class="metadata-chip" type="button" @onclick="() => RemoveSeries(series.Id)" aria-label="Remove series @title">@title <span aria-hidden="true">&times;</span></button>
                    }
                </div>
            }
        </section>

        <nav class="editor-tabs" aria-label="Editor view">
            <button type="button" aria-selected="@(_activePane == EditorPane.Edit)" @onclick="() => _activePane = EditorPane.Edit">Edit</button>
            @if (!_isCompactLayout)
            {
                <button class="split-mode" type="button" aria-selected="@(_activePane == EditorPane.Split)" @onclick="() => _activePane = EditorPane.Split">Split</button>
            }
            <button type="button" aria-selected="@(_activePane == EditorPane.Preview)" @onclick="() => _activePane = EditorPane.Preview">Preview</button>
        </nav>
        <div class="editor-workspace" @ref="_workspaceElement" aria-busy="@(_previewLoading || _imageUploading ? "true" : "false")">
            <section id="markdown-pane" class="editor-pane markdown-pane" aria-labelledby="markdown-heading">
                <header class="pane-heading" id="markdown-heading">
                    <span>Markdown</span>
                    <div class="pane-tools">
                        <label class="image-upload" aria-disabled="@_imageUploading">
                            @(_imageUploading ? "Uploading…" : "+ Add image")
                            <InputFile OnChange="HandleImageSelected" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" disabled="@_imageUploading" />
                        </label>
                    </div>
                </header>
                @if (_imageUploadError is not null) { <div class="upload-error" role="alert">@_imageUploadError</div> }
                <label class="visually-hidden" for="article-markdown">Article Markdown</label>
                <span id="markdown-editor-help" class="visually-hidden">Use Tab to indent. Press Control or Command S to save.</span>
                <textarea id="article-markdown" @ref="_markdownElement" aria-describedby="markdown-editor-help" placeholder="Start writing in Markdown…" spellcheck="true" value="@Current.Markdown" @oninput="HandleMarkdownInput"></textarea>
            </section>
            <div class="editor-splitter" role="separator" aria-orientation="vertical" aria-controls="markdown-pane preview-pane"
                 aria-valuemin="30" aria-valuemax="70" aria-valuenow="@FormatTypographyValue(_editorSplit)" aria-valuetext="@EditorSplitValueText"
                 tabindex="0" @onpointerdown="StartSplitterAsync" @onkeydown="HandleSplitterKeyDownAsync"
                 @ondblclick="ResetSplitterAsync">
                <span aria-hidden="true"></span>
            </div>
            <section id="preview-pane" class="editor-pane preview-pane" aria-labelledby="preview-heading" aria-live="polite">
                <header class="pane-heading" id="preview-heading">
                    <span>Preview</span>
                    <div class="preview-tools">
                        <span class="preview-live"><span aria-hidden="true"></span>Live</span>
                        <details class="preview-settings">
                            <summary>Preview settings</summary>
                            <div class="preview-settings__content">
                                <label>Line spacing <input type="range" min="1" max="2.2" step="0.05" value="@FormatTypographyValue(_typography.LineHeight)" @oninput="HandleLineHeightChanged" /><output>@FormatTypographyValue(_typography.LineHeight)</output></label>
                                <label>Paragraph spacing <input type="range" min="0.1" max="1.6" step="0.05" value="@FormatTypographyValue(_typography.BlockSpacing)" @oninput="HandleBlockSpacingChanged" /><output>@FormatTypographyValue(_typography.BlockSpacing)rem</output></label>
                            </div>
                        </details>
                    </div>
                </header>
                @if (string.IsNullOrWhiteSpace(Current.Markdown))
                {
                    <div class="preview-empty"><h2>Nothing to preview yet</h2><p>Start writing to see the rendered article.</p></div>
                }
                else if (_previewLoading) { <div class="preview-status" role="status">Rendering preview…</div> }
                else if (_previewError is not null) { <div class="preview-status preview-error" role="alert">@_previewError</div> }
                else { <article class="article-preview" @ref="_previewElement">@((MarkupString)_renderedHtml)</article> }
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public Guid? ArticleId { get; set; }
    private static readonly string[] SupportedLanguages = ["en", "ru"];
    private readonly Dictionary<string, LocalizationModel> _localizations = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<Guid> _topicIds = [];
    private readonly Dictionary<Guid, int> _series = [];
    private AdminTaxonomyDto _taxonomy = new([], [], []);
    private string _activeLanguage = "en";
    private string _tags = "";
    private string _renderedHtml = "";
    private string? _previewError;
    private string? _imageUploadError;
    private string? _message;
    private bool _hasError;
    private bool _loading = true;
    private bool _saving;
    private bool _isDirty;
    private bool _saveFailed;
    private bool _autosavePending;
    private bool _taxonomyDirty;
    private long _changeVersion;
    private string? _conflictLanguage;
    private LocalizationModel? _conflictServer;
    private bool _previewLoading;
    private bool _imageUploading;
    private EditorPane _activePane = EditorPane.Split;
    private decimal _editorSplit = 50m;
    private CancellationTokenSource? _previewCancellation;
    private ElementReference _workspaceElement;
    private ElementReference _markdownElement;
    private ElementReference _previewElement;
    private bool _previewElementReady;
    private bool _mathTypesetPending;
    private bool _typographyLoaded;
    private bool _editorSplitLoaded;
    private bool _markdownEnhancementsAttached;
    private bool _responsiveLayoutAttached;
    private bool _isCompactLayout;
    private CancellationTokenSource? _messageCancellation;
    private CancellationTokenSource? _autosaveCancellation;
    private DotNetObjectReference<ArticleEditor>? _splitterReference;
    private ArticleTypography _typography = ArticleTypography.Default;
    private DateTimeOffset? _savedAt;
    private LocalizationModel Current => _localizations[_activeLanguage];
    private bool IsBusy => _loading || _saving || _coverUploading;
    private bool CanSave => !IsBusy
        && _conflictLanguage is null
        && (ArticleId is null || _isDirty || _saveFailed);
    private bool CanPublishCurrent => Current.Status is PublicationStatusDto.Draft or PublicationStatusDto.Unpublished;
    private string StatusClass => Current.Status switch
    {
        PublicationStatusDto.Published => "is-published",
        PublicationStatusDto.Unpublished => "is-unpublished",
        _ => "is-draft"
    };
    private string SaveButtonLabel => _saving ? "Saving…" : _saveFailed ? "Retry" : _isDirty ? "Save changes" : "Save";
    private string SaveStatusClass => _saving ? "is-saving" : _saveFailed ? "is-error" : _isDirty ? "is-dirty" : "is-saved";
    private string SaveStatusText => _saving
        ? "Saving…"
        : _saveFailed
            ? "Save failed"
            : _isDirty
                ? "Unsaved changes"
                : _savedAt is { } savedAt
                    ? $"Saved {savedAt.ToLocalTime().ToString("HH:mm", CultureInfo.CurrentCulture)}"
                    : ArticleId is null ? "Not saved" : "All changes saved";
    private string TypographyStyle =>
        $"--article-line-height: {FormatTypographyValue(_typography.LineHeight)}; --article-block-spacing: {FormatTypographyValue(_typography.BlockSpacing)}rem; --editor-split: {FormatTypographyValue(_editorSplit)}%; --editor-preview-split: {FormatTypographyValue(100m - _editorSplit)}%;";
    private string EditorSplitValueText => $"{FormatTypographyValue(_editorSplit)}% Markdown, {FormatTypographyValue(100m - _editorSplit)}% Preview";

    protected override async Task OnInitializedAsync()
    {
        _localizations["en"] = new("en");
        try
        {
            _taxonomy = await ArticlesClient.GetTaxonomyAsync();
            if (ArticleId is { } articleId)
            {
                var article = await ArticlesClient.GetArticleAsync(articleId);
                _localizations.Clear();
                foreach (var localization in article.Localizations) _localizations[localization.LanguageCode] = new(localization);
                _activeLanguage = _localizations.Keys.FirstOrDefault() ?? "en";
                if (_localizations.Count == 0) _localizations["en"] = new("en");
                _topicIds.UnionWith(article.TopicIds);
                foreach (var assignment in article.Series) _series[assignment.SeriesId] = assignment.Position;
                _tags = string.Join(", ", article.Tags);
                await RefreshPreview();
            }
        }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException) { ShowMessage(exception.Message, true); }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_typographyLoaded)
        {
            try
            {
                var stored = await JS.InvokeAsync<ArticleTypography>("gaifulinLabTypography.get");
                _typography = ArticleTypography.FromOptional(stored.LineHeight, stored.BlockSpacing);
            }
            catch (JSException)
            {
                // Local storage is optional; the default density remains in effect.
            }

            _typographyLoaded = true;
            StateHasChanged();
        }

        if (!_editorSplitLoaded)
        {
            try
            {
                _editorSplit = ClampEditorSplit(await JS.InvokeAsync<decimal>("gaifulinLabEditorSplitter.get"));
            }
            catch (JSException)
            {
                // Local storage is optional; the even split remains in effect.
            }

            _editorSplitLoaded = true;
            StateHasChanged();
        }

        // Refresh the global shortcut target after every render. Blazor can replace an
        // editor instance during enhanced navigation while the JavaScript module stays
        // alive, so retaining the previous DotNetObjectReference would save the article
        // that is no longer on screen.
        if (!_loading)
        {
            _splitterReference ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("gaifulinLabEditorShortcuts.attach", _splitterReference);
            }
            catch (JSException)
            {
                // Ctrl/Cmd+S is an enhancement; the Save button remains available.
            }
        }

        if (!_responsiveLayoutAttached)
        {
            _splitterReference ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("gaifulinLabEditorResponsive.attach", _splitterReference);
                _responsiveLayoutAttached = true;
            }
            catch (JSException)
            {
                // The CSS layout remains usable when resize notifications are unavailable.
            }
        }

        if (!_loading && !_markdownEnhancementsAttached)
        {
            try
            {
                await JS.InvokeVoidAsync("gaifulinLabMarkdownEditor.attach", _markdownElement);
                _markdownEnhancementsAttached = true;
            }
            catch (JSException)
            {
                // Native textarea editing remains available when JavaScript is unavailable.
            }
        }

        if (_loading
            || _previewLoading
            || _previewError is not null
            || string.IsNullOrWhiteSpace(_renderedHtml))
        {
            return;
        }

        _previewElementReady = true;
        if (!_mathTypesetPending)
        {
            return;
        }

        _mathTypesetPending = false;
        try
        {
            await JS.InvokeVoidAsync("articleAssets.typesetMath", _previewElement);
        }
        catch (JSException)
        {
            // Raw TeX remains readable if the external renderer is unavailable.
        }
    }

    private async Task HandleLanguageChanged(ChangeEventArgs eventArgs)
    {
        var languageCode = eventArgs.Value?.ToString();
        if (languageCode is null
            || !SupportedLanguages.Contains(languageCode, StringComparer.OrdinalIgnoreCase)
            || string.Equals(languageCode, _activeLanguage, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (ArticleId is null)
        {
            var replacement = new LocalizationModel(languageCode, Current);
            _localizations.Clear();
            _localizations[languageCode] = replacement;
        }
        else if (!_localizations.ContainsKey(languageCode))
        {
            _localizations[languageCode] = new(languageCode);
        }

        _activeLanguage = languageCode;
        ClearMessage();
        await ClearPreviewMathAsync();
        _previewElementReady = false;
        _renderedHtml = "";
        await RefreshPreview();
    }

    private Task SaveAsync() => SaveCoreAsync(navigateAfterCreate: true);

    [JSInvokable]
    public Task SaveArticleAsync() => CanSave ? SaveAsync() : Task.CompletedTask;

    [JSInvokable]
    public Task SetCompactLayoutAsync(bool isCompactLayout)
    {
        if (_isCompactLayout == isCompactLayout)
        {
            return Task.CompletedTask;
        }

        _isCompactLayout = isCompactLayout;
        if (_isCompactLayout && _activePane == EditorPane.Split)
        {
            _activePane = EditorPane.Edit;
        }

        return InvokeAsync(StateHasChanged);
    }

    private async Task SaveCoreAsync(bool navigateAfterCreate, bool isAutomaticSave = false)
    {
        var saveVersion = _changeVersion;
        if (!isAutomaticSave)
        {
            CancelAutosaveDelay();
        }

        _autosavePending = false;
        _saving = true;
        ClearMessage();
        _hasError = false;
        _saveFailed = false;
        try
        {
            var wasNew = ArticleId is null;
            if (ArticleId is null)
            {
                var createRequest = Current.ToCreateRequest();
                var created = await ArticlesClient.CreateArticleAsync(createRequest);
                ArticleId = created.ArticleId;
                Current.MarkSaved(createRequest, created.LocalizationVersion);
            }
            foreach (var localization in _localizations.Values)
            {
                if (!localization.HasChanges)
                {
                    continue;
                }

                var request = localization.ToUpdateRequest();
                try
                {
                    var version = await ArticlesClient.UpdateLocalizationAsync(
                        ArticleId.Value,
                        localization.LanguageCode,
                        request);
                    localization.MarkSaved(request, version);
                }
                catch (AdminApiException exception) when (exception.Code == "article_edit_conflict")
                {
                    await LoadConflictAsync(localization);
                    throw;
                }
            }
            if (_taxonomyDirty)
            {
                await ArticlesClient.UpdateTaxonomyAsync(ArticleId.Value, new(
                    _topicIds.ToArray(),
                    _series.Select(item => new SeriesAssignmentRequest(item.Key, item.Value)).ToArray(),
                    ParseTags()));
            }
            if (_changeVersion == saveVersion)
            {
                _taxonomyDirty = false;
                await ReloadLocalizationsAsync();
            }
            RecalculateDirty();
            _savedAt = DateTimeOffset.Now;
            if (wasNew && navigateAfterCreate) Navigation.NavigateTo($"/admin/articles/{ArticleId}", replace: true);
        }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException)
        {
            _saveFailed = true;
            _autosavePending = false;
            if (_message is null)
            {
                ShowMessage(exception.Message, true);
            }
        }
        finally
        {
            _saving = false;
            if (!_saveFailed && _autosavePending && _isDirty && ArticleId is not null)
            {
                QueueAutosave();
            }
        }
    }

    private async Task PublishAsync()
    {
        if (string.IsNullOrWhiteSpace(Current.Title))
        {
            ShowMessage("Add a title before publishing.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(Current.Slug))
        {
            ShowMessage("Add a URL slug before publishing.", true);
            return;
        }

        var wasNew = ArticleId is null;
        await SaveCoreAsync(navigateAfterCreate: false);
        if (_hasError || ArticleId is null) return;
        _saving = true;
        try
        {
            await ArticlesClient.PublishAsync(ArticleId.Value, Current.LanguageCode);
            Current.Status = PublicationStatusDto.Published;
            ShowMessage("Localization published.", false);
            if (wasNew) Navigation.NavigateTo($"/admin/articles/{ArticleId}", replace: true);
        }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException) { ShowMessage(exception.Message, true); }
        finally { _saving = false; }
    }

    private async Task UnpublishAsync()
    {
        if (ArticleId is null) return;
        _saving = true;
        try { await ArticlesClient.UnpublishAsync(ArticleId.Value, Current.LanguageCode); Current.Status = PublicationStatusDto.Unpublished; ShowMessage("Localization unpublished.", false); }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException) { ShowMessage(exception.Message, true); }
        finally { _saving = false; }
    }

    private async Task DeleteAsync()
    {
        if (ArticleId is null
            || !await JS.InvokeAsync<bool>("confirm", "Delete this article? It will be hidden from everyone, but kept in storage."))
        {
            return;
        }

        _saving = true;
        ClearMessage();
        try
        {
            await ArticlesClient.DeleteAsync(ArticleId.Value);
            Navigation.NavigateTo("/admin/articles");
        }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException)
        {
            ShowMessage(exception.Message, true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleMarkdownInput(ChangeEventArgs eventArgs)
    {
        Current.Markdown = eventArgs.Value?.ToString() ?? "";
        MarkDirty();
        await RefreshPreview();
    }

    private async Task StartSplitterAsync(PointerEventArgs eventArgs)
    {
        if (_activePane != EditorPane.Split)
        {
            return;
        }

        _splitterReference ??= DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("gaifulinLabEditorSplitter.start", _workspaceElement, eventArgs.ClientX, _splitterReference);
        }
        catch (JSException)
        {
            // Keyboard controls remain available when JavaScript is unavailable.
        }
    }

    private Task ResetSplitterAsync() => SetEditorSplitAsync(50m);

    private Task HandleSplitterKeyDownAsync(KeyboardEventArgs eventArgs) => eventArgs.Key switch
    {
        "ArrowLeft" => SetEditorSplitAsync(_editorSplit - 5m),
        "ArrowRight" => SetEditorSplitAsync(_editorSplit + 5m),
        "Home" => SetEditorSplitAsync(30m),
        "End" => SetEditorSplitAsync(70m),
        _ => Task.CompletedTask
    };

    [JSInvokable]
    public async Task SetEditorSplitAsync(decimal value)
    {
        _editorSplit = ClampEditorSplit(value);
        try
        {
            _editorSplit = ClampEditorSplit(await JS.InvokeAsync<decimal>("gaifulinLabEditorSplitter.set", _editorSplit));
        }
        catch (JSException)
        {
            // Applying the current split does not depend on browser storage.
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task HandleLineHeightChanged(ChangeEventArgs eventArgs) =>
        UpdateTypographyAsync(eventArgs.Value?.ToString(), isLineHeight: true);

    private Task HandleBlockSpacingChanged(ChangeEventArgs eventArgs) =>
        UpdateTypographyAsync(eventArgs.Value?.ToString(), isLineHeight: false);

    private async Task UpdateTypographyAsync(string? value, bool isLineHeight)
    {
        if (!decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var number))
        {
            return;
        }

        _typography = isLineHeight
            ? ArticleTypography.FromOptional(number, _typography.BlockSpacing)
            : ArticleTypography.FromOptional(_typography.LineHeight, number);
        try
        {
            var stored = await JS.InvokeAsync<ArticleTypography>("gaifulinLabTypography.set", _typography);
            _typography = ArticleTypography.FromOptional(stored.LineHeight, stored.BlockSpacing);
        }
        catch (JSException)
        {
            // The current editor can still use the selected value without persistence.
        }
    }

    private static string FormatTypographyValue(decimal value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private static decimal ClampEditorSplit(decimal value) => Math.Clamp(value, 30m, 70m);

