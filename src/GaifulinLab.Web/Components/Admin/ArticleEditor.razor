    private async Task RefreshPreview()
    {
        var cancellation = new CancellationTokenSource();
        var cancellationToken = cancellation.Token;
        var previousCancellation = _previewCancellation;
        // Store this CTS as the current preview generation before cancelling the old one.
        _previewCancellation = cancellation;
        // A later refresh reads it as previousCancellation and cancels it.
        // Its continuation then fails IsCurrentPreview and cannot overwrite the newer preview.
        previousCancellation?.Cancel();

        // The editor can switch language while JavaScript clears the old preview.
        // Keep this invocation's snapshot and cancellation source alive until it resumes.
        var html = Current.Html;
        var isEmpty = string.IsNullOrWhiteSpace(html);
        try
        {
            await ClearPreviewMathAsync();
            if (!IsCurrentPreview(cancellation))
            {
                return;
            }

            _previewElementReady = false;
            _previewError = null;
            _previewLoading = !isEmpty;
            if (isEmpty)
            {
                _renderedHtml = "";
                return;
            }

            await Task.Delay(300, cancellationToken);
            var renderedHtml = await HtmlClient.PreviewAsync(html, cancellationToken);
            if (!IsCurrentPreview(cancellation))
            {
                return;
            }

            _renderedHtml = renderedHtml;
            _mathTypesetPending = true;
            _previewLoading = false;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (HttpRequestException)
        {
            if (IsCurrentPreview(cancellation))
            {
                _previewError = "Preview is temporarily unavailable.";
                _previewLoading = false;
            }
        }
        finally
        {
            if (ReferenceEquals(_previewCancellation, cancellation))
            {
                _previewCancellation = null;
            }

            // Only this invocation disposes its source; a newer preview may cancel it while it awaits JS.
            cancellation.Dispose();
        }
    }

    private bool IsCurrentPreview(CancellationTokenSource cancellation) =>
        !_disposed && ReferenceEquals(_previewCancellation, cancellation);

    private async Task ClearPreviewMathAsync()
    {
        if (!_previewElementReady)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("articleAssets.clearMath", _previewElement);
        }
        catch (JSException)
        {
        }
    }

    private async Task ReloadLocalizationsAsync(long expectedChangeVersion)
    {
        var activeLanguage = _activeLanguage;
        var article = await ArticlesClient.GetArticleAsync(ArticleId!.Value);
        // Inputs remain editable during the GET; its response must not replace a newer draft.
        if (_changeVersion != expectedChangeVersion)
        {
            return;
        }

        _localizations.Clear();
        foreach (var localization in article.Localizations)
        {
            _localizations[localization.LanguageCode] = new(localization);
        }

        _activeLanguage = _localizations.ContainsKey(activeLanguage)
            ? activeLanguage
            : _localizations.Keys.First();
    }

    private async Task LoadConflictAsync(LocalizationModel localization)
    {
        try
        {
            var article = await ArticlesClient.GetArticleAsync(ArticleId!.Value);
            var saved = article.Localizations.SingleOrDefault(item =>
                string.Equals(item.LanguageCode, localization.LanguageCode, StringComparison.OrdinalIgnoreCase));
            if (saved is not null)
            {
                _conflictLanguage = localization.LanguageCode;
                _conflictServer = new LocalizationModel(saved);
            }
        }
        catch (Exception exception) when (exception is AdminApiException or HttpRequestException)
        {
            ShowMessage(
                $"{localization.LanguageCode.ToUpperInvariant()} could not be saved, and the latest version could not be loaded. Your draft is still in the editor.",
                true);
        }
    }

    private async Task UseServerConflictAsync()
    {
        if (_conflictLanguage is null || _conflictServer is null)
        {
            return;
        }

        var languageCode = _conflictLanguage;
        _localizations[languageCode] = _conflictServer;
        _conflictLanguage = null;
        _conflictServer = null;
        _saveFailed = false;
        RecalculateDirty();
        if (string.Equals(_activeLanguage, languageCode, StringComparison.OrdinalIgnoreCase))
        {
            await RefreshPreview();
        }
    }

    private async Task SaveMyConflictDraftAsync()
    {
        if (IsBusy
            || HasUntitledDraftToSave
            || _conflictLanguage is null
            || _conflictServer is null
            || !_localizations.TryGetValue(_conflictLanguage, out var draft))
        {
            return;
        }

        draft.UseVersion(_conflictServer.Version
            ?? throw new InvalidOperationException("The saved localization does not have a version."));
        _conflictLanguage = null;
        _conflictServer = null;
        await SaveCoreAsync(navigateAfterCreate: false);
    }

