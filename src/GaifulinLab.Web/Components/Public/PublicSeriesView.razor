@inject PublicContentClient ContentClient

<main id="main-content" class="site-main series-page">
    <div class="site-container series-layout">
        @if (_loading) { <div role="status">@L["series.loading"]</div> }
        else if (_series is null) { <div class="series-state surface"><h1>@L["series.notFound"]</h1><p>@L["series.notFoundDescription"]</p></div> }
        else
        {
            <span class="eyebrow">@L["catalog.series.title"]</span>
            <h1>@_series.Title</h1>
            @if (!string.IsNullOrWhiteSpace(_series.Description)) { <p class="description">@_series.Description</p> }
            <ol class="series-list surface">
                @foreach (var article in _series.Articles)
                {
                    <li value="@article.Position"><a href="@($"/{_series.LanguageCode}/articles/{article.Slug}")"><strong>@article.Title</strong><span>@L.Format("common.byAuthorSummary", article.AuthorDisplayName, article.Summary ?? string.Empty)</span></a></li>
                }
            </ol>
        }
    </div>
</main>

@code {
    [Parameter, EditorRequired] public string LanguageCode { get; set; } = "en";
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    private PublicSeriesDetailsDto? _series;
    private bool _loading = true;
    protected override async Task OnParametersSetAsync()
    {
        await L.SynchronizeRouteCultureAsync(LanguageCode);
        _loading = true;
        try { _series = await ContentClient.GetSeriesDetailsAsync(LanguageCode, Slug); }
        catch (HttpRequestException) { _series = null; }
        finally { _loading = false; }
    }
}
