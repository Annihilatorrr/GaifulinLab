@using System.ComponentModel.DataAnnotations
@inject RegistrationClient RegistrationClient

<section class="registration-section" aria-labelledby="registration-title">
    <div class="registration-card surface">
        @if (_registeredDisplayName is not null)
        {
            <div class="registration-success" role="status">
                <span class="success-mark" aria-hidden="true">✓</span>
                <h1 id="registration-title">@L.Format("auth.welcome", _registeredDisplayName)</h1>
                <p>@L["auth.accountReady"]</p>
                <a class="button button-primary" href="@LoginUrl">@L["auth.signIn"]</a>
            </div>
        }
        else
        {
            <h1 id="registration-title">@L["auth.createAccount"]</h1>
            <p>@L["auth.createDescription"]</p>

            <EditForm Model="_registration" OnValidSubmit="RegisterAsync" class="registration-form">
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="registration-display-name">@L["profile.displayName"]</label>
                    <InputText id="registration-display-name"
                               autocomplete="name"
                               aria-describedby="registration-display-name-hint"
                               disabled="@_isSubmitting"
                               @bind-Value="_registration.DisplayName" />
                    <span id="registration-display-name-hint" class="field-hint">
                        @L["auth.displayNameHint"]
                    </span>
                    <ValidationMessage For="() => _registration.DisplayName" />
                </div>

                <div class="field">
                    <label for="registration-email">@L["auth.email"]</label>
                    <InputText id="registration-email"
                               type="email"
                               autocomplete="email"
                               inputmode="email"
                               aria-describedby="registration-email-hint"
                               disabled="@_isSubmitting"
                               @bind-Value="_registration.Login" />
                    <span id="registration-email-hint" class="field-hint">
                        @L["auth.emailHint"]
                    </span>
                    <ValidationMessage For="() => _registration.Login" />
                </div>

                <div class="field">
                    <label for="registration-password">@L["auth.password"]</label>
                    <InputText id="registration-password"
                               type="password"
                               autocomplete="new-password"
                               aria-describedby="registration-password-hint"
                               disabled="@_isSubmitting"
                               @bind-Value="_registration.Password" />
                    <span id="registration-password-hint" class="field-hint">
                        @L["auth.passwordHint"]
                    </span>
                    <ValidationMessage For="() => _registration.Password" />
                </div>

                <div class="field">
                    <label for="registration-confirm-password">@L["auth.confirmPassword"]</label>
                    <InputText id="registration-confirm-password"
                               type="password"
                               autocomplete="new-password"
                               disabled="@_isSubmitting"
                               @bind-Value="_registration.ConfirmPassword" />
                    <ValidationMessage For="() => _registration.ConfirmPassword" />
                </div>

                @if (_errorMessage is not null)
                {
                    <p class="registration-error" role="alert">@_errorMessage</p>
                }

                <button class="button button-primary registration-submit"
                        type="submit"
                        disabled="@_isSubmitting">
                    @(_isSubmitting ? L["auth.creatingAccount"] : L["auth.createAccount"])
                </button>
            </EditForm>
        }
    </div>
</section>

@code {
    [Parameter] public string? ReturnUrl { get; set; }
    private RegistrationModel _registration = null!;
    private string? _registeredDisplayName;
    private string? _errorMessage;
    private bool _isSubmitting;

    private string LoginUrl => IsSafeLocalReturnUrl(ReturnUrl)
        ? $"/admin/login?returnUrl={Uri.EscapeDataString(ReturnUrl!)}"
        : "/admin/login";

    protected override void OnInitialized() => _registration = new RegistrationModel(L);

    private async Task RegisterAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var result = await RegistrationClient.RegisterAsync(
            _registration.Login.Trim(),
            _registration.DisplayName.Trim(),
            _registration.Password);

        _isSubmitting = false;
        if (result.Succeeded)
        {
            _registeredDisplayName = _registration.DisplayName.Trim();
            _registration.Password = string.Empty;
            _registration.ConfirmPassword = string.Empty;
            return;
        }

        _errorMessage = L.ApiError(result.ErrorCode, "errors.registrationUnavailable");
    }

    private sealed class RegistrationModel(LocalizationService localizer) : IValidatableObject
    {
        public string DisplayName { get; set; } = string.Empty;

        public string Login { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (string.IsNullOrWhiteSpace(DisplayName)) yield return new(localizer["validation.displayNameRequired"], [nameof(DisplayName)]);
            else if (DisplayName.Length is < 2 or > 100) yield return new(localizer["validation.displayNameLength"], [nameof(DisplayName)]);
            if (string.IsNullOrWhiteSpace(Login)) yield return new(localizer["validation.emailRequired"], [nameof(Login)]);
            else if (Login.Length > 254) yield return new(localizer["validation.emailLength"], [nameof(Login)]);
            else if (!new EmailAddressAttribute().IsValid(Login)) yield return new(localizer["validation.emailInvalid"], [nameof(Login)]);
            if (string.IsNullOrEmpty(Password)) yield return new(localizer["validation.passwordRequired"], [nameof(Password)]);
            else if (Password.Length is < 8 or > 128) yield return new(localizer["validation.passwordLength"], [nameof(Password)]);
            if (string.IsNullOrEmpty(ConfirmPassword)) yield return new(localizer["validation.confirmPasswordRequired"], [nameof(ConfirmPassword)]);
            else if (!string.Equals(Password, ConfirmPassword, StringComparison.Ordinal)) yield return new(localizer["validation.passwordsMismatch"], [nameof(ConfirmPassword)]);
        }
    }

    private static bool IsSafeLocalReturnUrl(string? returnUrl) =>
        !string.IsNullOrWhiteSpace(returnUrl)
        && returnUrl.StartsWith("/", StringComparison.Ordinal)
        && !returnUrl.StartsWith("//", StringComparison.Ordinal)
        && !returnUrl.Contains("\\", StringComparison.Ordinal);
}
