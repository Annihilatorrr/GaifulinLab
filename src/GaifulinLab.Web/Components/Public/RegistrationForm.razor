@using System.ComponentModel.DataAnnotations
@inject RegistrationClient RegistrationClient

<section class="registration-section" aria-labelledby="registration-title">
    <div class="registration-card surface">
        @if (_registeredDisplayName is not null)
        {
            <div class="registration-success" role="status">
                <span class="success-mark" aria-hidden="true">✓</span>
                <span class="eyebrow">Account created</span>
                <h1 id="registration-title">Welcome, @_registeredDisplayName</h1>
                <p>Your account is ready. Sign in to create and manage your own articles.</p>
                <a class="button button-primary" href="/admin/login">Sign in</a>
            </div>
        }
        else
        {
            <span class="eyebrow">Gaifulin Lab account</span>
            <h1 id="registration-title">Create an account</h1>
            <p>Enter your email address and choose a strong password. You can then create and manage your own articles.</p>

            <EditForm Model="_registration" OnValidSubmit="RegisterAsync" class="registration-form">
                <DataAnnotationsValidator />

                <div class="field">
                    <label for="registration-display-name">Display name</label>
                    <InputText id="registration-display-name"
                               autocomplete="name"
                               aria-describedby="registration-display-name-hint"
                               disabled="@_isSubmitting"
                               @bind-Value="_registration.DisplayName" />
                    <span id="registration-display-name-hint" class="field-hint">
                        This name will appear publicly on your articles.
                    </span>
                    <ValidationMessage For="() => _registration.DisplayName" />
                </div>

                <div class="field">
                    <label for="registration-email">Email</label>
                    <InputText id="registration-email"
                               type="email"
                               autocomplete="email"
                               inputmode="email"
                               aria-describedby="registration-email-hint"
                               disabled="@_isSubmitting"
                               @bind-Value="_registration.Login" />
                    <span id="registration-email-hint" class="field-hint">
                        Enter the email address you want to use for your account.
                    </span>
                    <ValidationMessage For="() => _registration.Login" />
                </div>

                <div class="field">
                    <label for="registration-password">Password</label>
                    <InputText id="registration-password"
                               type="password"
                               autocomplete="new-password"
                               aria-describedby="registration-password-hint"
                               disabled="@_isSubmitting"
                               @bind-Value="_registration.Password" />
                    <span id="registration-password-hint" class="field-hint">
                        At least 8 characters with upper- and lowercase letters, a number, and a symbol.
                    </span>
                    <ValidationMessage For="() => _registration.Password" />
                </div>

                <div class="field">
                    <label for="registration-confirm-password">Confirm password</label>
                    <InputText id="registration-confirm-password"
                               type="password"
                               autocomplete="new-password"
                               disabled="@_isSubmitting"
                               @bind-Value="_registration.ConfirmPassword" />
                    <ValidationMessage For="() => _registration.ConfirmPassword" />
                </div>

                @if (_errorMessage is not null)
                {
                    <p class="registration-error" role="alert">@_errorMessage</p>
                }

                <button class="button button-primary registration-submit"
                        type="submit"
                        disabled="@_isSubmitting">
                    @(_isSubmitting ? "Creating account…" : "Create account")
                </button>
            </EditForm>
        }
    </div>
</section>

@code {
    private readonly RegistrationModel _registration = new();
    private string? _registeredDisplayName;
    private string? _errorMessage;
    private bool _isSubmitting;

    private async Task RegisterAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var result = await RegistrationClient.RegisterAsync(
            _registration.Login.Trim(),
            _registration.DisplayName.Trim(),
            _registration.Password);

        _isSubmitting = false;
        if (result.Succeeded)
        {
            _registeredDisplayName = _registration.DisplayName.Trim();
            _registration.Password = string.Empty;
            _registration.ConfirmPassword = string.Empty;
            return;
        }

        _registration.Password = string.Empty;
        _registration.ConfirmPassword = string.Empty;
        _errorMessage = result.ErrorMessage;
    }

    private sealed class RegistrationModel
    {
        [Required(ErrorMessage = "Display name is required.")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Display name must be between 2 and 100 characters.")]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [StringLength(254, ErrorMessage = "Email must not exceed 254 characters.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Login { get; set; } = string.Empty;

        [Required]
        [StringLength(128, MinimumLength = 8)]
        public string Password { get; set; } = string.Empty;

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
