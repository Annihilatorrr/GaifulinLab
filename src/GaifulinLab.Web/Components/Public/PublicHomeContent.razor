@inject PublicContentClient ContentClient

<section class="content-overview" aria-label="@L["home.contentAria"]">
    <div class="site-container overview-grid">
        <section class="overview-column">
            <header class="overview-heading"><h2>@L["home.latest.title"]</h2><a href="/articles">@L["common.viewAll"] →</a></header>
            @if (_articles.Count == 0) { <div class="overview-empty"><h3>@L["catalog.articles.emptyTitle"]</h3><p>@L["home.latest.empty"]</p></div> }
            else { @foreach (var article in _articles.Take(3)) { <a class="overview-link surface" href="@($"/{article.LanguageCode}/articles/{article.Slug}")"><strong>@article.Title</strong><span>@L.Format("common.byAuthorDate", article.AuthorDisplayName, L.FormatDateTime(article.PublishedAt))</span></a> } }
        </section>
        <section class="overview-column">
            <header class="overview-heading"><h2>@L["home.topics.title"]</h2><a href="/topics">@L["home.topics.all"] →</a></header>
            @if (_topics.Count == 0) { <div class="overview-empty"><h3>@L["catalog.topics.emptyTitle"]</h3><p>@L["home.topics.empty"]</p></div> }
            else { @foreach (var topic in _topics.Take(5)) { <a class="overview-link surface" href="@($"/articles?topic={Uri.EscapeDataString(topic.Slug)}")"><strong>@topic.Name</strong><span>@L.FormatArticleCount(topic.ArticleCount)</span></a> } }
        </section>
        <section class="overview-column">
            <header class="overview-heading"><h2>@L["home.series.title"]</h2><a href="/series">@L["home.series.all"] →</a></header>
            @if (_series.Count == 0) { <div class="overview-empty"><h3>@L["catalog.series.emptyTitle"]</h3><p>@L["home.series.empty"]</p></div> }
            else { @foreach (var series in _series.Take(5)) { <a class="overview-link surface" href="@($"/{series.LanguageCode}/series/{series.Slug}")"><strong>@series.Title</strong><span>@L.FormatArticleCount(series.ArticleCount)</span></a> } }
        </section>
    </div>
</section>

@code {
    private string LanguageCode => L.CurrentCode;
    private IReadOnlyList<PublicArticleListItemDto> _articles = [];
    private IReadOnlyList<PublicTopicDto> _topics = [];
    private IReadOnlyList<PublicSeriesListItemDto> _series = [];
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var requests = new Task[] { LoadArticles(), LoadTopics(), LoadSeries() };
            await Task.WhenAll(requests);
        }
        catch (HttpRequestException) { }
    }
    private async Task LoadArticles() => _articles = await ContentClient.GetArticlesAsync(LanguageCode, pageSize: 3);
    private async Task LoadTopics() => _topics = await ContentClient.GetTopicsAsync(LanguageCode);
    private async Task LoadSeries() => _series = await ContentClient.GetSeriesAsync(LanguageCode);
}
