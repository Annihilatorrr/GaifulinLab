@inject PublicContentClient ContentClient
@inject IJSRuntime JS
@using System.Globalization

<main id="main-content"
      class="site-main article-page"
      style="@TypographyStyle"
      data-pdf-ready="@(_pdfReady ? "true" : "false")">
    <div class="site-container article-layout">
        @if (_loading) { <div role="status">Loading article…</div> }
        else if (_article is null) { <div class="not-found surface"><h1>Article not found</h1><p>This localization is not published or does not exist.</p><a href="/articles">Back to articles</a></div> }
        else
        {
            <header class="article-header">
                <div class="article-meta">
                    <time datetime="@_article.PublishedAt.ToString("O")">@_article.PublishedAt.ToLocalTime().ToString("d MMM yyyy")</time>
                    @if (_typographyReady)
                    {
                        <a class="article-download" href="@PdfDownloadUrl" download>
                            @PdfDownloadLabel
                        </a>
                    }
                </div>
                <h1>@_article.Title</h1>
                @if (!string.IsNullOrWhiteSpace(_article.Summary)) { <p>@_article.Summary</p> }
                @if (_article.AvailableLocalizations.Count > 1)
                {
                    <nav aria-label="Available localizations">
                        @foreach (var localization in _article.AvailableLocalizations) { <a href="@localization.Url">@localization.LanguageCode.ToUpperInvariant()</a> }
                    </nav>
                }
            </header>
            <article class="article-body" @ref="_articleElement">@((MarkupString)_article.Html)</article>
        }
    </div>
</main>

@code {
    [Parameter, EditorRequired] public string LanguageCode { get; set; } = "en";
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter] public decimal? RequestedLineHeight { get; set; }
    [Parameter] public decimal? RequestedBlockSpacing { get; set; }
    [Parameter] public bool IsPdfRender { get; set; }
    private PublicArticleDetailsDto? _article;
    private bool _loading = true;
    private ElementReference _articleElement;
    private bool _articleElementReady;
    private bool _mathTypesetPending;
    private bool _pdfReady;
    private bool _articleAssetsPrepared;
    private bool _typographyReady;
    private ArticleTypography _typography = ArticleTypography.Default;

    private string PdfDownloadUrl =>
        ContentClient.GetArticlePdfUrl(LanguageCode, Slug, _typography);
    private string TypographyStyle =>
        $"--article-line-height: {_typography.LineHeight.ToString(CultureInfo.InvariantCulture)}; --article-block-spacing: {_typography.BlockSpacing.ToString(CultureInfo.InvariantCulture)}rem;";

    private string PdfDownloadLabel =>
        string.Equals(LanguageCode, "ru", StringComparison.OrdinalIgnoreCase)
            ? "Скачать PDF"
            : "Download PDF";

    protected override async Task OnParametersSetAsync()
    {
        await ClearArticleMathAsync();
        _articleElementReady = false;
        _pdfReady = false;
        _articleAssetsPrepared = false;
        _typographyReady = RequestedLineHeight.HasValue || RequestedBlockSpacing.HasValue;
        _typography = ArticleTypography.FromOptional(RequestedLineHeight, RequestedBlockSpacing);
        _loading = true;
        try
        {
            _article = await ContentClient.GetArticleAsync(LanguageCode, Slug, IsPdfRender);
            _mathTypesetPending = _article is not null;
        }
        catch (HttpRequestException) { _article = null; }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading)
        {
            return;
        }

        if (_article is null)
        {
            if (IsPdfRender && !_pdfReady)
            {
                _pdfReady = true;
                StateHasChanged();
            }

            return;
        }

        if (!_articleAssetsPrepared)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "articleAssets.prepare",
                    _articleElement,
                    IsPdfRender ? ContentClient.PdfAssetBaseUrl : ContentClient.AssetBaseUrl);
            }
            catch (JSException)
            {
                // The renderer will still wait for the browser's image state.
            }

            _articleAssetsPrepared = true;
            StateHasChanged();
            return;
        }

        if (!_typographyReady)
        {
            try
            {
                var stored = await JS.InvokeAsync<ArticleTypography>("gaifulinLabTypography.get");
                _typography = ArticleTypography.FromOptional(stored.LineHeight, stored.BlockSpacing);
            }
            catch (JSException)
            {
                // Local storage is optional; the default density remains in effect.
            }

            _typographyReady = true;
            StateHasChanged();
            return;
        }

        _articleElementReady = true;
        if (!_mathTypesetPending)
        {
            if (!_pdfReady)
            {
                _pdfReady = true;
                StateHasChanged();
            }

            return;
        }

        _mathTypesetPending = false;
        try
        {
            await JS.InvokeVoidAsync("MathJax.typesetClear", new[] { _articleElement });
            await JS.InvokeVoidAsync("MathJax.texReset");
            await JS.InvokeVoidAsync("MathJax.typesetPromise", new[] { _articleElement });
        }
        catch (JSException)
        {
            // Raw TeX remains readable if the external renderer is unavailable.
        }
        finally
        {
            _pdfReady = true;
            StateHasChanged();
        }
    }

    private async Task ClearArticleMathAsync()
    {
        if (!_articleElementReady)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("MathJax.typesetClear", new[] { _articleElement });
            await JS.InvokeVoidAsync("MathJax.texReset");
        }
        catch (JSException)
        {
        }
    }
}
