@inject PublicContentClient ContentClient
@inject IJSRuntime JS
@inject IConfiguration Configuration
@using System.Globalization

<main id="main-content"
      class="site-main article-page"
      style="@TypographyStyle">
    <div class="site-container article-layout">
        @if (_loading) { <div role="status">@L["article.loading"]</div> }
        else if (_article is null) { <div class="not-found surface"><h1>@L["article.notFound"]</h1><p>@L["article.notFoundDescription"]</p><a href="/articles">@L["article.back"]</a></div> }
        else
        {
            <header class="article-header">
                <div class="article-meta">
                    <div class="article-meta-info">
                        <time datetime="@_article.PublishedAt.ToString("O")">@L.Format("article.published", L.FormatDateTime(_article.PublishedAt))</time>
                        <span class="article-views">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Zm9.5 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" /></svg>
                            <span>@L.FormatViewCount(_article.ViewCount)</span>
                        </span>
                        <time datetime="@_article.LastEditedAt.ToString("O")">@L.Format("article.lastEdited", L.FormatDateTime(_article.LastEditedAt))</time>
                    </div>
                    @if (PublicPdfDownloadEnabled)
                    {
                        <AuthorizeView>
                            <Authorized>
                                <button class="article-download" @onclick="DownloadReaderPdfAsync" disabled="@_readerPdfDownloadInProgress">@(_readerPdfDownloadInProgress ? L["article.preparingPdf"] : L["article.downloadPdf"])</button>
                                @if (_readerPdfDownloadError is not null)
                                {
                                    <p class="article-download-error" role="alert">@_readerPdfDownloadError</p>
                                }
                            </Authorized>
                            <NotAuthorized>
                                <span><a href="@SignInForPdfUrl">@L["nav.signIn"]</a> @L["article.or"] <a href="@RegisterForPdfUrl">@L["nav.registerLower"]</a> @L["article.toDownloadPdf"]</span>
                            </NotAuthorized>
                        </AuthorizeView>
                    }
                </div>
                <h1>@_article.Title</h1>
                @if (!string.IsNullOrWhiteSpace(_article.Summary)) { <p>@_article.Summary</p> }
                @if (_article.AvailableLocalizations.Count > 1)
                {
                    <nav aria-label="@L["article.availableLocalizations"]">
                        @foreach (var localization in _article.AvailableLocalizations) { <a href="@localization.Url" data-article-localization-language="@localization.LanguageCode">@localization.LanguageCode.ToUpperInvariant()</a> }
                    </nav>
                }
            </header>
            <article class="article-content article-body" @ref="_articleElement">@((MarkupString)_article.Html)</article>
        }
    </div>
</main>

@code {
    [Parameter, EditorRequired] public string LanguageCode { get; set; } = "en";
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter] public decimal? RequestedLineHeight { get; set; }
    [Parameter] public decimal? RequestedBlockSpacing { get; set; }
    private PublicArticleDetailsDto? _article;
    private bool _loading = true;
    private ElementReference _articleElement;
    private bool _articleElementReady;
    private bool _mathTypesetPending;
    private bool _articleAssetsPrepared;
    private bool _typographyReady;
    private bool _readerPdfDownloadInProgress;
    private string? _readerPdfDownloadError;
    private ArticleTypography _typography = ArticleTypography.Default;

    private string TypographyStyle =>
        $"--article-line-height: {_typography.LineHeight.ToString(CultureInfo.InvariantCulture)}; --article-block-spacing: {_typography.BlockSpacing.ToString(CultureInfo.InvariantCulture)}rem;";

    private bool PublicPdfDownloadEnabled => Configuration.GetValue<bool>("Features:PublicPdfDownloadEnabled");
    private string SignInForPdfUrl => $"/admin/login?returnUrl={Uri.EscapeDataString($"/{LanguageCode}/articles/{Slug}")}";
    private string RegisterForPdfUrl => $"/register?returnUrl={Uri.EscapeDataString($"/{LanguageCode}/articles/{Slug}")}";

    protected override async Task OnParametersSetAsync()
    {
        await L.SynchronizeRouteCultureAsync(LanguageCode);
        await ClearArticleMathAsync();
        _articleElementReady = false;
        _articleAssetsPrepared = false;
        _typographyReady = RequestedLineHeight.HasValue || RequestedBlockSpacing.HasValue;
        _typography = ArticleTypography.FromOptional(RequestedLineHeight, RequestedBlockSpacing);
        _loading = true;
        try
        {
            _article = await ContentClient.GetArticleAsync(
                LanguageCode,
                Slug);
            if (_article is not null)
            {
                try
                {
                    var view = await ContentClient.RecordArticleViewAsync(LanguageCode, Slug);
                    _article = _article with { ViewCount = view.ViewCount };
                }
                catch (HttpRequestException)
                {
                    // Reading matters more than telemetry: leave the initially loaded count visible.
                }
            }
            _mathTypesetPending = _article is not null;
        }
        catch (HttpRequestException) { _article = null; }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading)
        {
            return;
        }

        if (_article is null) return;

        if (!_articleAssetsPrepared)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "articleAssets.prepare",
                    _articleElement,
                    ContentClient.AssetBaseUrl);
            }
            catch (JSException)
            {
                // The renderer will still wait for the browser's image state.
            }

            _articleAssetsPrepared = true;
            StateHasChanged();
            return;
        }

        if (!_typographyReady)
        {
            try
            {
                var stored = await JS.InvokeAsync<ArticleTypography>("gaifulinLabTypography.get");
                _typography = ArticleTypography.FromOptional(stored.LineHeight, stored.BlockSpacing);
            }
            catch (JSException)
            {
                // Local storage is optional; the default density remains in effect.
            }

            _typographyReady = true;
            StateHasChanged();
            return;
        }

        _articleElementReady = true;
        if (!_mathTypesetPending)
        {
            return;
        }

        _mathTypesetPending = false;
        try
        {
            await JS.InvokeVoidAsync("articleAssets.typesetMath", _articleElement);
        }
        catch (JSException)
        {
            // Raw TeX remains readable if the external renderer is unavailable.
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ClearArticleMathAsync()
    {
        if (!_articleElementReady)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("articleAssets.clearMath", _articleElement);
        }
        catch (JSException)
        {
        }
    }

    private async Task DownloadReaderPdfAsync()
    {
        _readerPdfDownloadInProgress = true;
        _readerPdfDownloadError = null;
        try
        {
            var pdf = await ContentClient.DownloadArticlePdfAsync(LanguageCode, Slug);
            await JS.InvokeVoidAsync("articleAssets.download", pdf, $"{Slug}.pdf");
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            _readerPdfDownloadError = L["article.pdfLimit"];
        }
        catch (HttpRequestException)
        {
            _readerPdfDownloadError = L["article.pdfUnavailable"];
        }
        finally
        {
            _readerPdfDownloadInProgress = false;
        }
    }
}
