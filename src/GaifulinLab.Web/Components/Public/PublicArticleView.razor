@inject PublicContentClient ContentClient
@inject IJSRuntime JS
@using System.Globalization

<main id="main-content"
      class="site-main article-page"
      style="@TypographyStyle">
    <div class="site-container article-layout">
        @if (_loading) { <div role="status">Loading article…</div> }
        else if (_article is null) { <div class="not-found surface"><h1>Article not found</h1><p>This localization is not published or does not exist.</p><a href="/articles">Back to articles</a></div> }
        else
        {
            <header class="article-header">
                <div class="article-meta">
                    <div class="article-meta-info">
                        <span class="article-author">By @_article.AuthorDisplayName</span>
                        <time datetime="@_article.PublishedAt.ToString("O")">@_article.PublishedAt.ToLocalTime().ToString("d MMM yyyy")</time>
                        <span class="article-views">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Zm9.5 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" /></svg>
                            <span>@_article.ViewCount @ViewCountLabel</span>
                        </span>
                        <time datetime="@_article.LastEditedAt.ToString("O")">Last edited @_article.LastEditedAt.ToLocalTime().ToString("d MMM yyyy")</time>
                    </div>
                    @if (_typographyReady)
                    {
                        <button class="article-download" @onclick="DownloadPdfAsync" disabled="@_pdfExportInProgress">
                            @PdfDownloadLabel
                        </button>
                    }
                </div>
                @if (_pdfExportError is not null)
                {
                    <p class="article-download-error" role="alert">@_pdfExportError</p>
                }
                <h1>@_article.Title</h1>
                @if (!string.IsNullOrWhiteSpace(_article.Summary)) { <p>@_article.Summary</p> }
                @if (_article.AvailableLocalizations.Count > 1)
                {
                    <nav aria-label="Available localizations">
                        @foreach (var localization in _article.AvailableLocalizations) { <a href="@localization.Url">@localization.LanguageCode.ToUpperInvariant()</a> }
                    </nav>
                }
            </header>
            <article class="article-body" @ref="_articleElement">@((MarkupString)_article.Html)</article>
        }
    </div>
</main>

@code {
    [Parameter, EditorRequired] public string LanguageCode { get; set; } = "en";
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter] public decimal? RequestedLineHeight { get; set; }
    [Parameter] public decimal? RequestedBlockSpacing { get; set; }
    private PublicArticleDetailsDto? _article;
    private bool _loading = true;
    private ElementReference _articleElement;
    private bool _articleElementReady;
    private bool _mathTypesetPending;
    private bool _articleAssetsPrepared;
    private bool _typographyReady;
    private bool _pdfExportInProgress;
    private string? _pdfExportError;
    private ArticleTypography _typography = ArticleTypography.Default;

    private string TypographyStyle =>
        $"--article-line-height: {_typography.LineHeight.ToString(CultureInfo.InvariantCulture)}; --article-block-spacing: {_typography.BlockSpacing.ToString(CultureInfo.InvariantCulture)}rem;";

    private string PdfDownloadLabel =>
        _pdfExportInProgress
            ? string.Equals(LanguageCode, "ru", StringComparison.OrdinalIgnoreCase)
                ? "Готовим PDF…"
                : "Preparing PDF…"
            : string.Equals(LanguageCode, "ru", StringComparison.OrdinalIgnoreCase)
            ? "Скачать PDF"
            : "Download PDF";

    private string ViewCountLabel =>
        string.Equals(_article?.LanguageCode, "ru", StringComparison.OrdinalIgnoreCase)
            ? "просмотров"
            : "views";

    protected override async Task OnParametersSetAsync()
    {
        await ClearArticleMathAsync();
        _articleElementReady = false;
        _articleAssetsPrepared = false;
        _typographyReady = RequestedLineHeight.HasValue || RequestedBlockSpacing.HasValue;
        _typography = ArticleTypography.FromOptional(RequestedLineHeight, RequestedBlockSpacing);
        _loading = true;
        try
        {
            _article = await ContentClient.GetArticleAsync(
                LanguageCode,
                Slug);
            if (_article is not null)
            {
                try
                {
                    var view = await ContentClient.RecordArticleViewAsync(LanguageCode, Slug);
                    _article = _article with { ViewCount = view.ViewCount };
                }
                catch (HttpRequestException)
                {
                    // Reading matters more than telemetry: leave the initially loaded count visible.
                }
            }
            _mathTypesetPending = _article is not null;
        }
        catch (HttpRequestException) { _article = null; }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading)
        {
            return;
        }

        if (_article is null) return;

        if (!_articleAssetsPrepared)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "articleAssets.prepare",
                    _articleElement,
                    ContentClient.AssetBaseUrl);
            }
            catch (JSException)
            {
                // The renderer will still wait for the browser's image state.
            }

            _articleAssetsPrepared = true;
            StateHasChanged();
            return;
        }

        if (!_typographyReady)
        {
            try
            {
                var stored = await JS.InvokeAsync<ArticleTypography>("gaifulinLabTypography.get");
                _typography = ArticleTypography.FromOptional(stored.LineHeight, stored.BlockSpacing);
            }
            catch (JSException)
            {
                // Local storage is optional; the default density remains in effect.
            }

            _typographyReady = true;
            StateHasChanged();
            return;
        }

        _articleElementReady = true;
        if (!_mathTypesetPending)
        {
            return;
        }

        _mathTypesetPending = false;
        try
        {
            await JS.InvokeVoidAsync("articleAssets.typesetMath", _articleElement);
        }
        catch (JSException)
        {
            // Raw TeX remains readable if the external renderer is unavailable.
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task DownloadPdfAsync()
    {
        _pdfExportInProgress = true;
        _pdfExportError = null;
        try
        {
            var export = await ContentClient.CreateArticlePdfExportAsync(LanguageCode, Slug, _typography);
            for (var attempt = 0; attempt < 60; attempt++)
            {
                if (string.Equals(export.Status, "completed", StringComparison.OrdinalIgnoreCase)
                    && !string.IsNullOrWhiteSpace(export.DownloadUrl))
                {
                    await JS.InvokeVoidAsync(
                        "articleAssets.download",
                        ContentClient.ResolveApiUrl(export.DownloadUrl));
                    return;
                }

                if (string.Equals(export.Status, "failed", StringComparison.OrdinalIgnoreCase))
                {
                    _pdfExportError = export.ErrorMessage ?? "The PDF export failed.";
                    return;
                }

                await Task.Delay(TimeSpan.FromSeconds(1));
                export = await ContentClient.GetPdfExportAsync(export.Id);
            }

            _pdfExportError = "The PDF export is taking longer than expected. Please try again.";
        }
        catch (HttpRequestException)
        {
            _pdfExportError = "Unable to start the PDF export.";
        }
        finally
        {
            _pdfExportInProgress = false;
            StateHasChanged();
        }
    }

    private async Task ClearArticleMathAsync()
    {
        if (!_articleElementReady)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("articleAssets.clearMath", _articleElement);
        }
        catch (JSException)
        {
        }
    }
}
