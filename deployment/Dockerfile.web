FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG API_BASE_URL=/
WORKDIR /src

COPY . .
RUN dotnet restore src/GaifulinLab.Web/GaifulinLab.Web.csproj
RUN dotnet publish src/GaifulinLab.Web/GaifulinLab.Web.csproj -c Release -o /app/publish
RUN printf '{\n  "Api": {\n    "BaseUrl": "%s"\n  }\n}\n' "$API_BASE_URL" > /app/publish/wwwroot/appsettings.json
RUN rm -f /app/publish/wwwroot/appsettings.json.br /app/publish/wwwroot/appsettings.json.gz

FROM nginx:1.27-alpine AS final
WORKDIR /usr/share/nginx/html
EXPOSE 80

COPY deployment/nginx-web/gaifulinlab.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/publish/wwwroot .
