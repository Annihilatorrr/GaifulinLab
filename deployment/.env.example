GAIFULINLAB_PUBLIC_ORIGIN=https://gaifulinlab.com

# PostgreSQL is installed directly on the production server by server/install-host.sh.
GAIFULINLAB_DB_HOST=192.168.50.142
GAIFULINLAB_DB_PORT=5432
GAIFULINLAB_DB_NAME=gaifulinlab
GAIFULINLAB_DB_USER=gaifulinlab
GAIFULINLAB_DB_PASSWORD=replace-with-a-long-random-password

GAIFULINLAB_JWT_ISSUER=GaifulinLab
GAIFULINLAB_JWT_AUDIENCE=GaifulinLab.Web
GAIFULINLAB_JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
GAIFULINLAB_JWT_LIFETIME_MINUTES=30

# Persistent server directory for uploaded media.
GAIFULINLAB_MEDIA_HOST_PATH=/home/ruslan/deployments/gaifulinlab/deployment/runtime/media
GAIFULINLAB_PDF_EXPORTS_HOST_PATH=/home/ruslan/deployments/gaifulinlab/deployment/runtime/pdf-exports

# PDF rendering stays inside the Docker network. These values only tune resource usage.
GAIFULINLAB_PDF_RENDERER_TIMEOUT_SECONDS=45
GAIFULINLAB_PDF_MAX_CONCURRENT_RENDERS=2

GAIFULINLAB_HOST_NGINX_BACKEND_HTTP_PORT=38190
GAIFULINLAB_HOST_NGINX_SERVER_NAMES=gaifulinlab.com,www.gaifulinlab.com
GAIFULINLAB_HOST_NGINX_CERT_FILE=/etc/letsencrypt/live/gaifulinlab.com/fullchain.pem
GAIFULINLAB_HOST_NGINX_CERT_KEY=/etc/letsencrypt/live/gaifulinlab.com/privkey.pem
GAIFULINLAB_HOST_NGINX_BOOTSTRAP_SELF_SIGNED=1
GAIFULINLAB_TLS_EMAIL=ruslanmgaifulin@gmail.com
