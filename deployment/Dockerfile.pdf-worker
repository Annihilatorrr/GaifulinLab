FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore src/GaifulinLab.Api/GaifulinLab.Api.csproj
RUN dotnet publish src/GaifulinLab.Api/GaifulinLab.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM node:22-bookworm-slim AS mathjax
WORKDIR /mathjax
RUN npm pack mathjax@4.0.0 \
    && tar -xzf mathjax-*.tgz

FROM mcr.microsoft.com/playwright/dotnet:v1.62.0-noble AS final
WORKDIR /app

COPY --from=build /app/publish .
COPY --from=mathjax /mathjax/package /app/pdf-assets/mathjax

ENTRYPOINT ["dotnet", "GaifulinLab.Api.dll"]
