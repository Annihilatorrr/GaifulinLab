FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore src/GaifulinLab.Api/GaifulinLab.Api.csproj
RUN dotnet publish src/GaifulinLab.Api/GaifulinLab.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080

# Npgsql can load GSSAPI support at runtime when PostgreSQL negotiates authentication.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "GaifulinLab.Api.dll"]
