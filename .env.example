# Docker Compose / PostgreSQL
POSTGRES_DB=gaifulinlab
POSTGRES_USER=gaifulinlab
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Single MVP administrator
ADMIN_LOGIN=admin
ADMIN_PASSWORD_HASH=replace-with-the-generated-password-hash

# JWT
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
JWT_ISSUER=GaifulinLab
JWT_AUDIENCE=GaifulinLab.Web.Client
JWT_LIFETIME_MINUTES=30

# Uploaded images volume
MEDIA_STORAGE_PATH=/app/data/media

# Nginx listener. Keep loopback when a host-level TLS proxy is used.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
